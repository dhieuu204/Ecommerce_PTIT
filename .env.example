# Biến dùng chung cho Docker Compose (infra/docker-compose.yml).
# Copy thành .env rồi sửa. Không commit file .env.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
RABBITMQ_USER=san
RABBITMQ_PASSWORD=san
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# Cổng web khi chạy cả hệ thống trong Docker (pnpm app:up)
WEB_PORT=8080

# Gửi mail thật khi chạy cả hệ thống trong Docker (pnpm app:up). Khi chạy pnpm dev thì điền ở services/user-service/.env.
# Để trống: gửi vào hộp thư giả Mailpit.
# SMTP_URL=smtps://<gmail>:<mat-khau-ung-dung>@smtp.gmail.com:465
