{
  "name": "san-tmdt",
  "private": true,
  "description": "Đồ án sàn thương mại điện tử nhiều shop trên microservices + Kubernetes",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./services/**\" --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "app:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build",
    "app:down": "docker compose -f infra/docker-compose.yml --profile app down",
    "postinstall": "pnpm --filter \"./packages/**\" build",
    "db:migrate": "pnpm -r --filter \"./services/**\" exec prisma migrate deploy",
    "seed:demo": "pnpm --filter @san/user-service seed:demo && pnpm --filter @san/approval-service seed:demo && pnpm --filter @san/marketplace-service seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
