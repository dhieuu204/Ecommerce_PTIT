PORT=3002
DATABASE_URL=postgresql://marketplace_svc:marketplace_svc@localhost:5432/market_db?schema=public
RABBITMQ_URL=amqp://san:san@localhost:5672
# Nơi lấy khóa công khai để kiểm access token (user-service)
JWKS_URL=http://localhost:3001/api/user/v1/.well-known/jwks.json

# GHN môi trường dev (danh sách tỉnh/huyện/xã). Để trống: dùng danh sách MẪU (mô phỏng, mã không phải mã GHN).
# Token lấy ở trang khách hàng GHN dev; chỉ ghi trong .env, không commit.
GHN_TOKEN=
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# MinIO (ảnh). Khớp infra/docker-compose.yml; trang quản lý http://localhost:9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_PUBLIC_BUCKET=san-public
# Địa chỉ trình duyệt mở ảnh
PUBLIC_FILE_URL=http://localhost:9000

# Con số cấu hình P1
SHOP_LOGO_MAX_MB=2

# Con số cấu hình P2
CART_MAX_ITEMS=100
VOUCHER_MAX_DAYS=180
