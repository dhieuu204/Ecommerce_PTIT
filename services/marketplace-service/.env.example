PORT=3002
DATABASE_URL=postgresql://marketplace_svc:marketplace_svc@localhost:5432/market_db?schema=public
RABBITMQ_URL=amqp://san:san@localhost:5672
# Nơi lấy khóa công khai để kiểm access token (user-service)
JWKS_URL=http://localhost:3001/api/user/v1/.well-known/jwks.json

# GHN môi trường dev (danh sách tỉnh/huyện/xã). Để trống: dùng danh sách MẪU (mô phỏng, mã không phải mã GHN).
# Token lấy ở trang khách hàng GHN dev; chỉ ghi trong .env, không commit.
GHN_TOKEN=
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# MinIO (ảnh). Khớp infra/docker-compose.yml; trang quản lý http://localhost:9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_PUBLIC_BUCKET=san-public
# Địa chỉ trình duyệt mở ảnh
PUBLIC_FILE_URL=http://localhost:9000

# Con số cấu hình P1
SHOP_LOGO_MAX_MB=2

# Con số cấu hình P2
# Giỏ hàng tối đa bao nhiêu dòng, voucher dài tối đa bao nhiêu ngày
CART_MAX_ITEMS=100
VOUCHER_MAX_DAYS=180
# Sản phẩm: ảnh tối đa (MB), số ảnh chung, số lựa chọn mỗi nhóm, giá (đồng), khối lượng (g), tồn mỗi biến thể
PRODUCT_IMAGE_MAX_MB=5
PRODUCT_MAX_IMAGES=9
VARIANT_MAX_OPTIONS=10
PRICE_MIN=1000
PRICE_MAX=500000000
WEIGHT_MAX_GRAMS=30000
STOCK_MAX=999999

# P3: đặt hàng. Các con số nghiệp vụ (hạn thanh toán, giữ tồn, hạn xác nhận, phí ship cố định)
# nằm trong bảng settings, admin sửa ở trang "Cấu hình chính sách".
# Mã shop trên GHN dev, gửi kèm khi tính phí ship (không bắt buộc)
GHN_SHOP_ID=
# Gọi user-service lấy sổ địa chỉ, gọi payment-service tạo lần thanh toán
USER_API_URL=http://localhost:3001/api/user/v1
PAYMENT_API_URL=http://localhost:3003/api/payment/v1
# Bản xem trước checkout dùng được bao nhiêu phút
CHECKOUT_PREVIEW_MINUTES=30

# ----- P4: giao hàng -----
# Có GHN_TOKEN thì tạo vận đơn thật trên GHN dev; để trống thì dùng vận chuyển MÔ PHỎNG (admin bấm các mốc
# giao hàng ở trang "GHN mô phỏng").
# Mã bí mật gắn vào đường dẫn webhook GHN: /api/market/v1/webhooks/ghn?token=<mã này>. Chỉ ghi trong .env.
GHN_WEBHOOK_TOKEN=
# Kích thước kiện mặc định gửi GHN (cm)
PACKAGE_LENGTH_CM=20
PACKAGE_WIDTH_CM=15
PACKAGE_HEIGHT_CM=10

# ----- P5: trả hàng -----
# Các hạn (shop trả lời, giao hàng trả, kiểm hàng, khiếu nại) nằm trong bảng settings (trang "Cấu hình chính sách").
# Bucket MinIO riêng tư cho ảnh bằng chứng trả hàng (chỉ xem qua API có kiểm quyền)
MINIO_PRIVATE_BUCKET=san-market-private
# Ảnh bằng chứng: dung lượng tối đa mỗi ảnh (MB), số ảnh tối đa mỗi lần gửi
RETURN_IMAGE_MAX_MB=5
RETURN_MAX_IMAGES=6

# ----- P6: đánh giá, chat, báo cáo vi phạm, realtime -----
# Hạn đánh giá (30 ngày) nằm trong bảng settings (trang "Cấu hình chính sách").
# Ảnh đánh giá: dung lượng tối đa mỗi ảnh (MB), số ảnh tối đa mỗi đánh giá
REVIEW_IMAGE_MAX_MB=5
REVIEW_MAX_IMAGES=5
# Ảnh gửi trong chat (MB)
CHAT_IMAGE_MAX_MB=5
# Ảnh bằng chứng khi báo cáo vi phạm: dung lượng tối đa (MB), số ảnh tối đa
REPORT_IMAGE_MAX_MB=5
REPORT_MAX_IMAGES=5
# Redis cho Socket.IO (chat, thông báo tức thời) khi chạy nhiều bản service. Để trống: chỉ dùng trong một bản
REDIS_URL=redis://localhost:6379
