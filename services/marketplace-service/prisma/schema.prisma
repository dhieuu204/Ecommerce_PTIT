// Schema của marketplace-service [M]. Chỉ service này được đọc/ghi database market_db.
// Bảng P1, P2 đã đủ cột. Khung các phase sau: docs/erd/README.md.

generator client {
  provider = "prisma-client-js"
  // Mỗi service sinh client riêng, không dùng chung node_modules/@prisma/client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Địa chỉ hành chính (mã theo GHN, lấy từ API GHN và cập nhật mỗi ngày) =====

model Province {
  /// ProvinceID của GHN
  id   Int    @id
  name String @db.VarChar(100)

  districts District[]

  @@map("provinces")
}

model District {
  /// DistrictID của GHN
  id         Int    @id
  provinceId Int    @map("province_id")
  name       String @db.VarChar(100)

  province Province @relation(fields: [provinceId], references: [id])
  wards    Ward[]

  @@index([provinceId])
  @@map("districts")
}

model Ward {
  /// WardCode của GHN
  code       String @db.VarChar(20)
  districtId Int    @map("district_id")
  name       String @db.VarChar(100)

  district District @relation(fields: [districtId], references: [id])

  @@id([districtId, code])
  @@map("wards")
}

// ===== Shop =====

enum ShopStatus {
  /// Đã nộp hồ sơ lần đầu, đang chờ duyệt
  PENDING
  /// Hồ sơ lần đầu bị từ chối, sửa và nộp lại
  REJECTED
  /// Đang hoạt động, vào được Kênh người bán
  ACTIVE
  /// Admin đình chỉ (SHP-04): sản phẩm không hiện, không mua được; seller vẫn vào Kênh người bán và sửa hàng
  SUSPENDED
}

enum ApplicationType {
  /// Hồ sơ mở shop
  REGISTER
  /// Đổi tên shop hoặc tài khoản ngân hàng sau khi đã duyệt
  CHANGE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  /// Seller nộp bản mới trước khi admin xét bản này
  REPLACED
}

/// Shop (1 tài khoản 1 shop). Các cột là thông tin ĐANG DÙNG, trống cho tới khi hồ sơ đầu tiên được duyệt.
model Shop {
  id                String     @id @default(uuid()) @db.Uuid
  /// Chủ shop (userId bên user-service)
  ownerId           String     @unique @map("owner_id") @db.Uuid
  status            ShopStatus @default(PENDING)
  name              String?    @unique @db.VarChar(80)
  description       String?    @db.VarChar(3000)
  logoUrl           String?    @map("logo_url") @db.VarChar(255)
  phone             String?    @db.VarChar(10)
  pickupProvinceId  Int?       @map("pickup_province_id")
  pickupDistrictId  Int?       @map("pickup_district_id")
  pickupWardCode    String?    @map("pickup_ward_code") @db.VarChar(20)
  pickupStreet      String?    @map("pickup_street") @db.VarChar(200)
  /// Địa chỉ lấy hàng đầy đủ bằng chữ, để hiển thị
  pickupAddress     String?    @map("pickup_address") @db.VarChar(400)
  bankName          String?    @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?    @map("bank_account_number") @db.VarChar(30)
  bankAccountName   String?    @map("bank_account_name") @db.VarChar(100)
  /// Lý do đình chỉ gần nhất (hiện cho seller), xóa khi khôi phục
  suspendReason     String?    @map("suspend_reason") @db.VarChar(500)
  /// Nhận thanh toán khi nhận hàng (COD, P4)
  codEnabled        Boolean    @default(true) @map("cod_enabled")
  /// Thời điểm của quyết định đình chỉ/khôi phục đã áp dụng: sự kiện cũ hơn tới sau thì bỏ qua
  moderatedAt       DateTime?  @map("moderated_at") @db.Timestamptz(3)
  /// Số đánh giá và tổng số sao của mọi sản phẩm trong shop (P6): sao shop = trung bình sao sản phẩm
  ratingCount       Int        @default(0) @map("rating_count")
  ratingTotal       Int        @default(0) @map("rating_total")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications  ShopApplication[]
  products      Product[]
  vouchers      Voucher[]
  shopOrders    ShopOrder[]
  reviews       Review[]
  followers     ShopFollow[]
  conversations Conversation[]

  @@map("shops")
}

/// Hồ sơ shop đã nộp. Mỗi lần nộp là một phiên bản (version 1, 2, 3...); mỗi shop tối đa 1 hồ sơ đang chờ.
model ShopApplication {
  id           String            @id @default(uuid()) @db.Uuid
  shopId       String            @map("shop_id") @db.Uuid
  version      Int
  type         ApplicationType
  status       ApplicationStatus @default(PENDING)
  /// Toàn bộ hồ sơ lúc nộp (dạng ShopApplicationData trong packages/shared)
  data         Json
  rejectReason String?           @map("reject_reason") @db.VarChar(500)
  /// Header Idempotency-Key: gửi lại cùng key thì trả lại hồ sơ này, không tạo bản mới
  requestKey   String            @unique @map("request_key") @db.VarChar(64)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, version])
  @@map("shop_applications")
}

// ===== Sản phẩm (P2) =====

/// Danh mục 2 cấp: cấp 1 hiện trên thanh danh mục (có icon), sản phẩm gắn vào cấp 2
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  /// Trống = danh mục cấp 1
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(60)
  /// Dùng trên đường dẫn web, ví dụ dien-thoai
  slug      String   @unique @db.VarChar(80)
  /// Tên icon lucide cho danh mục cấp 1, ví dụ smartphone
  icon      String?  @db.VarChar(40)
  /// Số nhỏ đứng trước
  sort      Int      @default(0)
  /// Ẩn khỏi web; sản phẩm đang gắn vẫn giữ nguyên
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  /// Đang bán (hiện cho buyer nếu shop đang hoạt động)
  ACTIVE
  /// Seller tạm ẩn; không xóa để giữ lịch sử
  HIDDEN
  /// Admin kiểm duyệt gỡ do vi phạm (P6, MOD-01): không hiện trên sàn, seller không tự bật lại được
  REMOVED
}

/// Sản phẩm. Giá và tồn nằm ở từng biến thể (product_variants)
model Product {
  id            String                   @id @default(uuid()) @db.Uuid
  shopId        String                   @map("shop_id") @db.Uuid
  /// Danh mục cấp 2
  categoryId    String                   @map("category_id") @db.Uuid
  name          String                   @db.VarChar(120)
  description   String                   @db.VarChar(5000)
  status        ProductStatus            @default(ACTIVE)
  /// Tên nhóm phân loại, ví dụ "Màu sắc", "Dung lượng". Trống = không có nhóm đó
  option1Name   String?                  @map("option1_name") @db.VarChar(30)
  option2Name   String?                  @map("option2_name") @db.VarChar(30)
  /// Cân nặng khi đóng gói (gram), để tính phí ship GHN
  weight        Int
  /// Giá thấp nhất / cao nhất trong các biến thể đang bán, tính lại mỗi lần lưu (để lọc và sắp xếp theo giá)
  minPrice      Int                      @map("min_price")
  maxPrice      Int                      @map("max_price")
  /// Số đã bán (tăng từ P3)
  soldCount     Int                      @default(0) @map("sold_count")
  /// Số đánh giá và tổng số sao (P6). Sao trung bình = rating_total / rating_count, tính khi đọc (không lưu số thực)
  ratingCount   Int                      @default(0) @map("rating_count")
  ratingTotal   Int                      @default(0) @map("rating_total")
  /// Lý do gỡ khi status = REMOVED (P6, hiện cho seller)
  removedReason String?                  @map("removed_reason") @db.VarChar(500)
  /// Thời điểm của quyết định gỡ/khôi phục đã áp dụng: sự kiện cũ hơn tới sau thì bỏ qua (P6)
  moderatedAt   DateTime?                @map("moderated_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Từ khóa tìm kiếm đã bỏ dấu, PostgreSQL tự tính từ tên (cột GENERATED viết tay trong migration p2)
  searchVector  Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, f_unaccent(lower((name)::text)))")) @map("search_vector")

  shop     Shop             @relation(fields: [shopId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  likes    ProductLike[]

  @@index([shopId, status])
  @@index([categoryId, status])
  @@index([searchVector], type: Gin)
  @@map("products")
}

/// Biến thể (SKU): mỗi tổ hợp lựa chọn có giá và tồn riêng. Sản phẩm không phân loại có đúng 1 biến thể ('', '')
model ProductVariant {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  /// Lựa chọn của nhóm 1 và nhóm 2, '' nếu không có nhóm đó
  option1Value  String  @default("") @map("option1_value") @db.VarChar(30)
  option2Value  String  @default("") @map("option2_value") @db.VarChar(30)
  /// Giá bán (đồng)
  price         Int
  /// Giá gốc để hiện gạch ngang và nhãn giảm %, trống = không giảm
  originalPrice Int?    @map("original_price")
  /// Tồn kho
  stock         Int
  /// Đang giữ cho đơn chưa thanh toán (dùng từ P3); tồn không được chỉnh xuống dưới số này
  reserved      Int     @default(0)
  sort          Int     @default(0)
  /// false = seller đã bỏ tổ hợp này; giữ dòng vì giỏ hàng và đơn cũ còn trỏ tới
  active        Boolean @default(true)

  product    Product        @relation(fields: [productId], references: [id])
  stockLogs  StockHistory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, option1Value, option2Value])
  @@map("product_variants")
}

/// Ảnh sản phẩm: tối đa 9 ảnh chung + 1 ảnh cho mỗi lựa chọn của nhóm 1 (ví dụ mỗi màu)
model ProductImage {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  url          String  @db.VarChar(255)
  sort         Int     @default(0)
  /// Trống = ảnh chung; có giá trị = ảnh của lựa chọn đó ở nhóm 1
  option1Value String? @map("option1_value") @db.VarChar(30)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

/// Lịch sử thay đổi tồn kho (INV-01). Chỉ thêm, không sửa
model StockHistory {
  id         String   @id @default(uuid()) @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  /// Số thay đổi: dương = nhập thêm, âm = bớt
  change     Int
  /// Tồn sau khi đổi
  stockAfter Int      @map("stock_after")
  /// Ví dụ "Tạo sản phẩm", "Nhập hàng", "Kiểm kho"
  reason     String   @db.VarChar(200)
  /// Người đổi (userId)
  createdBy  String   @map("created_by") @db.Uuid
  /// Đơn làm thay đổi tồn (bán, hủy đơn đã trả); trống = seller tự điều chỉnh
  orderId    String?  @map("order_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([variantId, createdAt])
  @@map("stock_history")
}

// ===== Giỏ hàng, voucher (P2) =====

/// Giỏ hàng: mỗi người mỗi biến thể một dòng
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  /// Người mua (userId bên user-service)
  userId    String   @map("user_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  /// Được tick để mua
  selected  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@map("cart_items")
}

enum DiscountType {
  /// Giảm số tiền cố định
  AMOUNT
  /// Giảm theo %, có mức giảm tối đa
  PERCENT
}

/// Voucher shop (shop_id có giá trị, shop chịu tiền giảm) hoặc voucher sàn (shop_id trống, sàn chịu). Áp vào đơn từ P3
model Voucher {
  id           String       @id @default(uuid()) @db.Uuid
  /// Trống = voucher sàn
  shopId       String?      @map("shop_id") @db.Uuid
  /// Mã buyer nhập, chữ in hoa và số, không trùng trên toàn sàn
  code         String       @unique @db.VarChar(20)
  /// Tên hiển thị, ví dụ "Giảm 50K đơn từ 500K"
  name         String       @db.VarChar(100)
  discountType DiscountType @map("discount_type")
  /// AMOUNT: số đồng; PERCENT: số % (1–100)
  value        Int
  /// Chỉ với PERCENT: giảm tối đa bao nhiêu đồng
  maxDiscount  Int?         @map("max_discount")
  /// Đơn tối thiểu (tiền hàng) để dùng được
  minOrder     Int          @default(0) @map("min_order")
  startAt      DateTime     @map("start_at") @db.Timestamptz(3)
  endAt        DateTime     @map("end_at") @db.Timestamptz(3)
  /// Tổng số lượt dùng
  quantity     Int
  /// Mỗi người dùng tối đa mấy lần
  perUserLimit Int          @default(1) @map("per_user_limit")
  /// Số lượt đã dùng (tăng từ P3)
  usedCount    Int          @default(0) @map("used_count")
  /// Người tạo (userId)
  createdBy    String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop   Shop?          @relation(fields: [shopId], references: [id])
  usages VoucherUsage[]

  @@index([shopId, endAt])
  @@map("vouchers")
}

/// Lượt dùng voucher (VCH-02). Giới hạn mỗi người đếm các dòng chưa trả lượt
model VoucherUsage {
  id          String    @id @default(uuid()) @db.Uuid
  voucherId   String    @map("voucher_id") @db.Uuid
  /// Người mua (userId)
  userId      String    @map("user_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  /// Trống = voucher sàn (áp cho cả đơn tổng)
  shopOrderId String?   @map("shop_order_id") @db.Uuid
  /// Số tiền đã giảm
  amount      Int
  /// Lúc trả lại lượt (đơn bị hủy); trống = đang dùng
  returnedAt  DateTime? @map("returned_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher   Voucher    @relation(fields: [voucherId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  shopOrder ShopOrder? @relation(fields: [shopOrderId], references: [id])

  @@index([voucherId, userId])
  @@index([orderId])
  @@map("voucher_usages")
}

// ===== Đơn hàng (P3) =====

/// Bản xem trước khi đặt (ORD-01). id là mã phiên: đặt hàng gửi lại cùng mã thì trả đơn đã tạo
model Checkout {
  id        String   @id @default(uuid()) @db.Uuid
  /// Người mua (userId)
  buyerId   String   @map("buyer_id") @db.Uuid
  /// Lựa chọn của buyer: dòng giỏ, địa chỉ, mã voucher
  input     Json
  /// Bản xem trước: giá, voucher, phí ship, địa chỉ (chép từ user-service)
  data      Json
  total     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// Đơn đã tạo từ phiên này
  orderId   String?  @unique @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id])

  @@index([buyerId, createdAt])
  @@map("checkouts")
}

enum PaymentMethod {
  VNPAY
  /// Thanh toán khi nhận hàng (P4)
  COD
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  /// Thanh toán khi nhận hàng: GHN thu hộ, không có hạn thanh toán
  COD
}

enum OrderCheckStatus {
  PENDING
  PASSED
  REJECTED
}

/// Đơn tổng: một lần đặt. Trạng thái chung tính từ các đơn con, không lưu
model Order {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Ngày đặt (YYMMDD) + 6 ký tự, ví dụ 261011ABC123
  code                String             @unique @db.VarChar(20)
  buyerId             String             @map("buyer_id") @db.Uuid
  buyerName           String             @map("buyer_name") @db.VarChar(100)
  buyerEmail          String             @map("buyer_email") @db.VarChar(255)
  paymentMethod       PaymentMethod      @default(VNPAY) @map("payment_method")
  // Địa chỉ nhận (chép lại lúc đặt)
  receiverName        String             @map("receiver_name") @db.VarChar(100)
  receiverPhone       String             @map("receiver_phone") @db.VarChar(15)
  provinceId          Int                @map("province_id")
  districtId          Int                @map("district_id")
  wardCode            String             @map("ward_code") @db.VarChar(20)
  /// Địa chỉ đầy đủ để hiển thị
  address             String             @db.VarChar(400)
  /// Voucher sàn (cả đơn tối đa 1)
  platformVoucherId   String?            @map("platform_voucher_id") @db.Uuid
  platformVoucherCode String?            @map("platform_voucher_code") @db.VarChar(20)
  platformDiscount    Int                @default(0) @map("platform_discount")
  /// Tổng tiền hàng các đơn con
  subtotal            Int
  /// Tổng phí ship các đơn con
  shippingFee         Int                @map("shipping_fee")
  /// Buyer phải trả = tổng total các đơn con
  total               Int
  paymentStatus       OrderPaymentStatus @default(UNPAID) @map("payment_status")
  checkStatus         OrderCheckStatus   @default(PENDING) @map("check_status")
  /// Hạn thanh toán (trống với COD)
  payBefore           DateTime?          @map("pay_before") @db.Timestamptz(3)
  /// Hết giữ tồn: chưa trả tới lúc này thì hủy cả đơn (trống với COD)
  holdUntil           DateTime?          @map("hold_until") @db.Timestamptz(3)
  paidAt              DateTime?          @map("paid_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  shopOrders    ShopOrder[]
  voucherUsages VoucherUsage[]
  stockHistory  StockHistory[]
  checkout      Checkout?

  @@index([buyerId, createdAt])
  @@index([paymentStatus, holdUntil])
  @@map("orders")
}

enum ShopOrderStatus {
  /// Chờ thanh toán và kiểm tra đơn
  PENDING
  /// Chờ shop xác nhận
  TO_CONFIRM
  /// Shop đã xác nhận, chờ giao hàng
  CONFIRMED
  /// Buyer xin hủy, chờ shop trả lời
  CANCEL_REQUESTED
  CANCELLED
  /// GHN đã lấy hàng, đang giao (P4)
  SHIPPING
  /// GHN giao thành công; đếm ngày tới hoàn tất
  DELIVERED
  COMPLETED
  /// Giao thất bại lần cuối, GHN đang hoàn kiện về shop
  RETURNING
  /// GHN báo đã hoàn kiện, chờ shop xác nhận đã nhận
  RETURNED
  /// Đóng: giao thất bại
  FAILED
  /// GHN báo thất lạc/hư hỏng, chờ admin xác nhận
  INCIDENT
  /// Đóng: sự cố đã xác nhận
  INCIDENT_RESOLVED
}

enum CancelActor {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

enum ShippingFeeSource {
  /// Giá thật từ API GHN
  GHN
  /// GHN lỗi: phí dự phòng trong cấu hình, sàn chịu chênh lệch
  FALLBACK
  /// Chưa nối GHN: phí cố định trong cấu hình
  FIXED
}

enum RefundStatus {
  NONE
  PROCESSING
  NEEDS_MANUAL
  SUCCEEDED
  MANUAL_DONE
}

/// Đơn con: phần của một shop trong đơn tổng, có vòng đời riêng (STATE-01)
model ShopOrder {
  id                  String            @id @default(uuid()) @db.Uuid
  /// Mã đơn tổng + "-1", "-2"
  code                String            @unique @db.VarChar(24)
  orderId             String            @map("order_id") @db.Uuid
  shopId              String            @map("shop_id") @db.Uuid
  /// Tên shop lúc đặt
  shopName            String            @map("shop_name") @db.VarChar(80)
  status              ShopOrderStatus   @default(PENDING)
  /// Tiền hàng
  subtotal            Int
  shopVoucherId       String?           @map("shop_voucher_id") @db.Uuid
  shopVoucherCode     String?           @map("shop_voucher_code") @db.VarChar(20)
  shopDiscount        Int               @default(0) @map("shop_discount")
  /// Phần voucher sàn chia cho đơn con này (sàn chịu)
  platformDiscount    Int               @default(0) @map("platform_discount")
  shippingFee         Int               @map("shipping_fee")
  shippingFeeSource   ShippingFeeSource @map("shipping_fee_source")
  /// Buyer trả = subtotal - shopDiscount - platformDiscount + shippingFee
  total               Int
  /// Phí sàn theo phần vạn (500 = 5%), payment-service chụp; có khi đơn đã trả
  platformFeeRate     Int?              @map("platform_fee_rate")
  platformFee         Int?              @map("platform_fee")
  /// Seller dự kiến nhận
  sellerAmount        Int?              @map("seller_amount")
  /// Hạn shop xác nhận (khi sang TO_CONFIRM)
  confirmBefore       DateTime?         @map("confirm_before") @db.Timestamptz(3)
  confirmedAt         DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  cancelledBy         CancelActor?      @map("cancelled_by")
  cancelReason        String?           @map("cancel_reason") @db.VarChar(500)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// Buyer xin hủy sau khi shop xác nhận
  cancelRequestReason String?           @map("cancel_request_reason") @db.VarChar(500)
  cancelRequestedAt   DateTime?         @map("cancel_requested_at") @db.Timestamptz(3)
  /// Đã dùng lượt xin hủy (mỗi đơn con 1 lần)
  cancelRequestUsed   Boolean           @default(false) @map("cancel_request_used")
  /// Trạng thái hoàn tiền (nhận từ payment-service)
  refundStatus        RefundStatus      @default(NONE) @map("refund_status")
  refundUpdatedAt     DateTime?         @map("refund_updated_at") @db.Timestamptz(3)
  // ----- P4: giao hàng -----
  /// Số GHN thu hộ (COD), 0 với trả trước
  codAmount           Int               @default(0) @map("cod_amount")
  /// Hạn bàn giao cho GHN (tính từ lúc sang TO_CONFIRM)
  handoverBefore      DateTime?         @map("handover_before") @db.Timestamptz(3)
  pickedAt            DateTime?         @map("picked_at") @db.Timestamptz(3)
  deliveredAt         DateTime?         @map("delivered_at") @db.Timestamptz(3)
  /// Tự hoàn tất lúc này nếu người mua chưa bấm "Đã nhận"
  completeBefore      DateTime?         @map("complete_before") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// GHN báo đã hoàn kiện về shop
  returnedAt          DateTime?         @map("returned_at") @db.Timestamptz(3)
  /// Shop chưa xác nhận nhận kiện tới lúc này thì tự đóng, không cộng kho
  returnCloseBefore   DateTime?         @map("return_close_before") @db.Timestamptz(3)
  /// Ghi chú khi admin xác nhận sự cố GHN
  incidentNote        String?           @map("incident_note") @db.VarChar(500)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order          @relation(fields: [orderId], references: [id])
  shop          Shop           @relation(fields: [shopId], references: [id])
  items         OrderItem[]
  history       OrderHistory[]
  voucherUsages VoucherUsage[]
  shipments     Shipment[]
  /// Yêu cầu trả hàng (P5), mỗi đơn con tối đa một
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([shopId, status, createdAt])
  @@index([status, confirmBefore])
  @@map("shop_orders")
}

/// Dòng hàng trong đơn con (chép lại tên, ảnh, giá lúc đặt)
model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  shopOrderId      String  @map("shop_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  productName      String  @map("product_name") @db.VarChar(120)
  /// Ví dụ "Đen, 128GB"; '' nếu không phân loại
  variantName      String  @map("variant_name") @db.VarChar(80)
  image            String? @db.VarChar(255)
  price            Int
  originalPrice    Int?    @map("original_price")
  quantity         Int
  /// Khối lượng 1 sản phẩm (gram), để tính lại phí ship
  weight           Int
  /// Phần voucher shop + sàn chia cho dòng này (dùng khi trả hàng ở P5)
  discount         Int     @default(0)
  /// Số món đã được hoàn đủ tiền do trả hàng (P5)
  returnedQuantity Int     @default(0) @map("returned_quantity")

  shopOrder   ShopOrder      @relation(fields: [shopOrderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
  /// Đánh giá của dòng hàng này (P6), mỗi dòng tối đa một
  review      Review?

  @@index([shopOrderId])
  @@map("order_items")
}

/// Lịch sử trạng thái đơn con. Chỉ thêm, không sửa
model OrderHistory {
  id          String           @id @default(uuid()) @db.Uuid
  shopOrderId String           @map("shop_order_id") @db.Uuid
  fromStatus  ShopOrderStatus? @map("from_status")
  toStatus    ShopOrderStatus  @map("to_status")
  actorType   CancelActor      @map("actor_type")
  actorId     String?          @map("actor_id") @db.Uuid
  actorName   String?          @map("actor_name") @db.VarChar(100)
  /// Lý do hoặc ghi chú
  note        String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id])

  @@index([shopOrderId, createdAt])
  @@map("order_history")
}

// ===== Giao hàng (P4) =====

enum ShipmentType {
  DELIVERY
  /// Hàng trả của người mua (P5)
  RETURN
}

enum Carrier {
  GHN
  /// Đơn vị vận chuyển mô phỏng (chưa có GHN_TOKEN)
  MOCK
}

enum ShipmentStatus {
  /// Đang gọi GHN tạo vận đơn
  CREATING
  /// Tạo vận đơn bị lỗi mạng: tra cứu GHN theo mã đơn con, không gửi lại mù quáng
  UNKNOWN
  /// GHN từ chối tạo: seller bấm tạo lại
  CREATE_FAILED
  READY_TO_PICK
  /// GHN đã lấy hàng, đang giao
  PICKED
  DELIVERED
  RETURNING
  RETURNED
  /// Đã hủy phía sàn, chờ báo hủy với GHN (job thử lại)
  CANCELLING
  CANCELLED
  /// Thất lạc, hư hỏng
  LOST
}

/// Vận đơn GHN (SHIP-02). Mỗi đơn con một vận đơn mỗi loại; mã gửi GHN là mã đơn con nên gửi lại không tạo trùng
model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  shopOrderId    String         @map("shop_order_id") @db.Uuid
  type           ShipmentType   @default(DELIVERY)
  carrier        Carrier
  /// client_order_code gửi GHN (= mã đơn con)
  clientCode     String         @unique @map("client_code") @db.VarChar(40)
  /// Mã vận đơn GHN trả về
  ghnCode        String?        @unique @map("ghn_code") @db.VarChar(40)
  status         ShipmentStatus @default(CREATING)
  codAmount      Int            @default(0) @map("cod_amount")
  /// gram
  weight         Int
  /// Phí GHN tính cho vận đơn
  fee            Int?
  failedAttempts Int            @default(0) @map("failed_attempts")
  pickedAt       DateTime?      @map("picked_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  returnedAt     DateTime?      @map("returned_at") @db.Timestamptz(3)
  /// Thời điểm của tin GHN mới nhất đã áp
  lastEventAt    DateTime?      @map("last_event_at") @db.Timestamptz(3)
  lastError      String?        @map("last_error") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  shopOrder ShopOrder         @relation(fields: [shopOrderId], references: [id])
  history   ShipmentHistory[]

  @@unique([shopOrderId, type])
  @@index([status])
  @@map("shipments")
}

enum EventSource {
  GHN
  MOCK
}

/// Các mốc GHN báo về (SHIP-03). Chỉ thêm, không sửa; tin trùng bị chặn bởi event_key
model ShipmentHistory {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  /// Mã trạng thái gốc của GHN, ví dụ delivering, delivery_fail
  ghnStatus  String         @map("ghn_status") @db.VarChar(40)
  /// Trạng thái vận đơn sau khi quy đổi
  status     ShipmentStatus
  source     EventSource
  /// Chống tin lặp: mã vận đơn + mã trạng thái + thời điểm
  eventKey   String         @unique @map("event_key") @db.VarChar(120)
  note       String?        @db.VarChar(300)
  happenedAt DateTime       @map("happened_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, happenedAt])
  @@map("shipment_history")
}

// ===== Trả hàng (P5) =====

/// Vòng đời yêu cầu trả hàng (STATE-03, docs/phan-tich/12-quyet-dinh-p5.md mục 3)
enum ReturnStatus {
  /// Chờ shop trả lời; quá hạn thì tự chấp nhận
  REQUESTED
  /// Shop từ chối, người mua còn khiếu nại được tới hạn
  REJECTED
  /// Đang khiếu nại, chờ admin hỗ trợ phân xử (approval-service)
  DISPUTED
  /// Đã chấp nhận: chờ GHN lấy hàng ở nhà người mua và chuyển về shop
  SHIPPING_BACK
  /// Hàng trả đã về shop, chờ shop kiểm
  RECEIVED
  /// Đã quyết hoàn tiền, payment-service đang hoàn
  REFUNDING
  /// Đã hoàn xong
  REFUNDED
  /// Đóng, không hoàn tiền
  CLOSED
  /// Người mua hủy, hoặc quá hạn giao hàng trả
  CANCELLED
}

/// Lý do trả hàng: chỉ lỗi hàng hoặc lỗi shop
enum ReturnReason {
  /// Hàng lỗi, không hoạt động
  DEFECTIVE
  /// Hàng bị hư hỏng, bể vỡ
  DAMAGED
  /// Giao sai mẫu, màu, size
  WRONG_ITEM
  /// Thiếu hàng, thiếu phụ kiện
  MISSING
  /// Không đúng mô tả
  NOT_AS_DESCRIBED
  /// Hàng giả, hàng nhái
  COUNTERFEIT
}

enum DisputeStage {
  /// Shop từ chối yêu cầu, người mua khiếu nại
  REQUEST_REJECTED
  /// Shop báo hàng trả về không đúng
  GOODS_PROBLEM
}

/// Yêu cầu trả hàng (RET-01..04). Mỗi đơn con tối đa một yêu cầu
model ReturnRequest {
  id                  String        @id @default(uuid()) @db.Uuid
  /// Mã đơn con + "-TH"; cũng là mã gửi GHN của vận đơn trả
  code                String        @unique @db.VarChar(28)
  shopOrderId         String        @unique @map("shop_order_id") @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  shopId              String        @map("shop_id") @db.Uuid
  /// Người mua (userId)
  buyerId             String        @map("buyer_id") @db.Uuid
  status              ReturnStatus  @default(REQUESTED)
  reason              ReturnReason
  description         String        @db.VarChar(1000)
  /// Ảnh bằng chứng của người mua (khóa file trong bucket riêng tư)
  images              String[]
  /// Số hoàn tối đa = tổng số người mua đã trả cho các món trả
  refundAmount        Int           @map("refund_amount")
  /// Tiền hàng sau voucher shop của các món trả (payment-service tính phần trừ tiền seller)
  sellerBase          Int           @map("seller_base")
  /// Shop (hoặc admin) chọn hoàn tiền không cần gửi hàng về
  refundWithoutReturn Boolean       @default(false) @map("refund_without_return")
  // Tài khoản nhận tiền hoàn (chỉ đơn COD)
  bankName            String?       @map("bank_name") @db.VarChar(100)
  bankAccountNumber   String?       @map("bank_account_number") @db.VarChar(30)
  bankAccountName     String?       @map("bank_account_name") @db.VarChar(100)
  /// Lời shop khi từ chối, hoặc khi báo hàng trả về không đúng
  sellerNote          String?       @map("seller_note") @db.VarChar(1000)
  sellerImages        String[]      @map("seller_images")
  /// Lời người mua khi khiếu nại
  disputeNote         String?       @map("dispute_note") @db.VarChar(1000)
  disputeImages       String[]      @map("dispute_images")
  /// Giai đoạn tranh chấp gần nhất
  disputeStage        DisputeStage? @map("dispute_stage")
  /// Hạn của bước đang chờ (shop trả lời / GHN lấy hàng / shop kiểm hàng / người mua khiếu nại)
  deadline            DateTime?     @db.Timestamptz(3)
  /// Số tiền đã quyết hoàn (nhỏ hơn refund_amount khi admin quyết hoàn một phần)
  decidedRefund       Int?          @map("decided_refund")
  /// Sàn chịu, seller không bị trừ tiền (kiện trả bị GHN làm thất lạc)
  platformCovers      Boolean       @default(false) @map("platform_covers")
  /// Trạng thái khoản hoàn (nhận từ payment-service)
  refundStatus        RefundStatus  @default(NONE) @map("refund_status")
  refundUpdatedAt     DateTime?     @map("refund_updated_at") @db.Timestamptz(3)
  /// Các bước đã qua: [{ at, actorType, actorName, action, note }]
  history             Json          @default("[]")
  /// Idempotency-Key lúc gửi yêu cầu
  requestKey          String        @unique @map("request_key") @db.VarChar(64)
  /// Lúc có kết quả (quyết hoàn tiền, đóng, hủy)
  resolvedAt          DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shopOrder ShopOrder    @relation(fields: [shopOrderId], references: [id])
  items     ReturnItem[]

  @@index([buyerId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([status, deadline])
  @@map("returns")
}

/// Món trả trong một yêu cầu: dòng hàng, số lượng, tiền
model ReturnItem {
  id           String  @id @default(uuid()) @db.Uuid
  returnId     String  @map("return_id") @db.Uuid
  orderItemId  String  @map("order_item_id") @db.Uuid
  quantity     Int
  /// Người mua đã trả cho số món này (giá trừ phần giảm giá của dòng chia theo số lượng)
  refundAmount Int     @map("refund_amount")
  /// Tiền hàng sau voucher shop của số món này
  sellerBase   Int     @map("seller_base")
  /// Shop chọn nhập lại kho lúc kiểm hàng
  restocked    Boolean @default(false)

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnId, orderItemId])
  @@map("return_items")
}

/// Cấu hình có phiên bản (ADM-01): hạn thanh toán, giữ tồn, hạn xác nhận, phí ship cố định.
/// Mỗi lần sửa thêm một phiên bản; phiên bản lớn nhất đang dùng
// ===== Đánh giá, theo dõi (P6) =====

/// Đánh giá sản phẩm (ENG-01): mỗi dòng hàng của đơn con đã hoàn tất được đánh giá 1 lần, sửa 1 lần
model Review {
  id              String    @id @default(uuid()) @db.Uuid
  /// Dòng hàng được đánh giá (không trùng)
  orderItemId     String    @unique @map("order_item_id") @db.Uuid
  shopOrderId     String    @map("shop_order_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  /// Người mua (userId bên user-service) và tên lúc đánh giá; web hiện tên đã che bớt
  buyerId         String    @map("buyer_id") @db.Uuid
  buyerName       String    @map("buyer_name") @db.VarChar(100)
  /// Phân loại đã mua, chép từ dòng hàng, ví dụ "Đen, 128GB"
  variantName     String    @map("variant_name") @db.VarChar(80)
  /// 1–5 sao
  rating          Int
  content         String    @default("") @db.VarChar(1000)
  /// Đường dẫn ảnh (bucket công khai), tối đa 5
  images          String[]  @default([])
  /// Đã dùng lượt sửa (mỗi đánh giá sửa được 1 lần)
  edited          Boolean   @default(false)
  /// Shop trả lời (ENG-02); không sửa được nội dung của người mua
  sellerReply     String?   @map("seller_reply") @db.VarChar(1000)
  sellerRepliedAt DateTime? @map("seller_replied_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  shop      Shop      @relation(fields: [shopId], references: [id])

  @@index([productId, createdAt])
  @@index([shopId, createdAt])
  @@index([buyerId, createdAt])
  @@map("reviews")
}

/// Theo dõi shop (ENG-03): mỗi người theo dõi một shop tối đa một dòng
model ShopFollow {
  userId    String   @map("user_id") @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id])

  @@id([userId, shopId])
  @@index([shopId])
  @@map("shop_follows")
}

/// Thả tim sản phẩm (ENG-03): mỗi người một sản phẩm tối đa một dòng
model ProductLike {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@index([productId])
  @@map("product_likes")
}

// ===== Chat, thông báo (P6) =====

/// Cuộc trò chuyện giữa một người mua và một shop (MSG-01). Người mua mở, shop trả lời
model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  buyerId            String    @map("buyer_id") @db.Uuid
  /// Tên người mua lúc mở chat (để shop thấy trong danh sách)
  buyerName          String    @map("buyer_name") @db.VarChar(100)
  shopId             String    @map("shop_id") @db.Uuid
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(3)
  /// Vài chữ đầu của tin cuối, ví dụ "[Hình ảnh]"
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(120)
  /// Số tin chưa đọc của mỗi bên
  buyerUnread        Int       @default(0) @map("buyer_unread")
  shopUnread         Int       @default(0) @map("shop_unread")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id])
  messages Message[]

  @@unique([buyerId, shopId])
  @@index([shopId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
  @@map("conversations")
}

enum MessageSender {
  BUYER
  SHOP
}

enum MessageType {
  TEXT
  /// Ảnh (bucket riêng tư, chỉ hai bên xem qua API có kiểm quyền)
  IMAGE
  /// Thẻ sản phẩm
  PRODUCT
  /// Thẻ đơn hàng (đơn con của chính người mua ở shop này)
  ORDER
}

/// Tin nhắn. Chỉ thêm, không sửa
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  /// userId người gửi (người mua, hoặc chủ shop)
  senderId       String        @map("sender_id") @db.Uuid
  senderRole     MessageSender @map("sender_role")
  type           MessageType
  /// Chữ (TEXT), khóa ảnh (IMAGE), mã sản phẩm (PRODUCT) hoặc mã đơn con (ORDER)
  content        String        @db.VarChar(1000)
  /// Bản chụp thẻ sản phẩm/đơn lúc gửi (tên, ảnh, giá / mã đơn, trạng thái, tổng tiền)
  card           Json?
  /// Mã do web sinh mỗi lần bấm gửi: gửi lại cùng mã thì trả tin cũ, không tạo tin mới
  clientKey      String        @map("client_key") @db.VarChar(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, clientKey])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Thông báo trong app (MSG-02). Việc quan trọng còn gửi email (qua user-service)
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  /// Người nhận (userId bên user-service)
  userId    String    @map("user_id") @db.Uuid
  /// Loại, ví dụ ORDER_DELIVERED (danh sách ở docs/phan-tich/13-quyet-dinh-p6.md)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(150)
  content   String    @db.VarChar(500)
  /// Đường dẫn trên web khi bấm vào thông báo
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Setting {
  key           String   @db.VarChar(64)
  version       Int
  value         Int
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  /// Admin sửa (userId)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(100)
  reason        String?  @db.VarChar(500)

  @@id([key, version])
  @@map("settings")
}

// ===== Bảng kỹ thuật: giống nhau ở cả 4 service =====

/// Nhật ký thao tác admin (ADM-02). Chỉ thêm, không sửa, không xóa.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(100)
  /// Ví dụ SET_PERMISSIONS, APPROVE_SHOP
  action     String   @db.VarChar(64)
  /// Ví dụ USER, SHOP
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(64)
  reason     String?  @db.VarChar(500)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Sự kiện chờ gửi lên RabbitMQ. Ghi cùng lúc (cùng giao dịch) với dữ liệu nghiệp vụ, tiến trình riêng gửi đi.
model OutboxEvent {
  /// = eventId của sự kiện
  id        String    @id @db.Uuid
  type      String    @db.VarChar(100)
  /// Toàn bộ sự kiện (EventEnvelope trong packages/shared)
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// null = chưa gửi được
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([sentAt])
  @@map("outbox_events")
}

/// Sự kiện đã nhận và xử lý xong. Gặp lại cùng id thì bỏ qua (RabbitMQ có thể giao 2 lần).
model InboxEvent {
  /// = eventId của sự kiện
  id          String   @id @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("inbox_events")
}
