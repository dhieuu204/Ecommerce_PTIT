// Schema của user-service [U]. Chỉ service này được đọc/ghi database user_db.
// Bảng P1 đã đủ cột. Khung các phase sau: docs/erd/README.md.

generator client {
  provider = "prisma-client-js"
  // Mỗi service sinh client riêng, không dùng chung node_modules/@prisma/client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Bộ quyền admin: kiểm duyệt, hỗ trợ, tài chính, quản trị hệ thống
enum Permission {
  MODERATION
  SUPPORT
  FINANCE
  SYSTEM
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Tài khoản. Một tài khoản vừa mua vừa bán được; admin là tài khoản có ít nhất một bộ quyền.
model User {
  id               String       @id @default(uuid()) @db.Uuid
  /// Luôn lưu chữ thường
  email            String       @unique @db.VarChar(254)
  /// Mật khẩu đã băm (bcrypt); null nếu chỉ đăng nhập bằng Google
  passwordHash     String?      @map("password_hash") @db.VarChar(100)
  /// Mã tài khoản Google đã gộp vào (nếu có)
  googleId         String?      @unique @map("google_id") @db.VarChar(255)
  fullName         String       @map("full_name") @db.VarChar(100)
  phone            String?      @db.VarChar(10)
  birthday         DateTime?    @db.Date
  gender           Gender?
  status           UserStatus   @default(UNVERIFIED)
  /// Bộ quyền admin; rỗng = không phải admin
  permissions      Permission[] @default([])
  /// Đăng nhập sai liên tiếp; đủ 5 lần thì khóa đăng nhập 15 phút
  failedLogins     Int          @default(0) @map("failed_logins")
  loginLockedUntil DateTime?    @map("login_locked_until") @db.Timestamptz(3)
  /// Lý do admin khóa tài khoản (status = LOCKED)
  lockReason       String?      @map("lock_reason") @db.VarChar(500)
  lastLoginAt      DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCodes VerificationCode[]
  sessions          Session[]
  addresses         Address[]

  @@map("users")
}

/// Mã 6 số gửi qua email để xác minh tài khoản hoặc đặt lại mật khẩu. Hạn 10 phút, sai tối đa 5 lần, dùng 1 lần.
model VerificationCode {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  purpose   CodePurpose
  /// Mã đã băm, không lưu mã gốc
  codeHash  String      @map("code_hash") @db.VarChar(100)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  attempts  Int         @default(0)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

/// Phiên đăng nhập trên một thiết bị (giữ refresh token 7 ngày).
/// Mỗi lần làm mới, token_hash đổi sang token mới; đăng xuất hoặc bị khóa thì ghi revoked_at.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Refresh token đã băm (SHA-256), không lưu token gốc
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Trình duyệt / thiết bị, để người dùng nhận ra phiên
  device    String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sổ địa chỉ (tối đa 10 mỗi người, đúng 1 địa chỉ mặc định). Mã tỉnh/huyện/xã theo GHN, tên lưu kèm để hiển thị.
model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  receiverName String   @map("receiver_name") @db.VarChar(100)
  phone        String   @db.VarChar(10)
  provinceId   Int      @map("province_id")
  districtId   Int      @map("district_id")
  wardCode     String   @map("ward_code") @db.VarChar(20)
  provinceName String   @map("province_name") @db.VarChar(100)
  districtName String   @map("district_name") @db.VarChar(100)
  wardName     String   @map("ward_name") @db.VarChar(100)
  /// Số nhà, tên đường
  street       String   @db.VarChar(200)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ===== Bảng kỹ thuật: giống nhau ở cả 4 service =====

/// Nhật ký thao tác admin (ADM-02). Chỉ thêm, không sửa, không xóa.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(100)
  /// Ví dụ SET_PERMISSIONS, APPROVE_SHOP
  action     String   @db.VarChar(64)
  /// Ví dụ USER, SHOP
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(64)
  reason     String?  @db.VarChar(500)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Sự kiện chờ gửi lên RabbitMQ. Ghi cùng lúc (cùng giao dịch) với dữ liệu nghiệp vụ, tiến trình riêng gửi đi.
model OutboxEvent {
  /// = eventId của sự kiện
  id        String    @id @db.Uuid
  type      String    @db.VarChar(100)
  /// Toàn bộ sự kiện (EventEnvelope trong packages/shared)
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// null = chưa gửi được
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([sentAt])
  @@map("outbox_events")
}

/// Sự kiện đã nhận và xử lý xong. Gặp lại cùng id thì bỏ qua (RabbitMQ có thể giao 2 lần).
model InboxEvent {
  /// = eventId của sự kiện
  id          String   @id @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("inbox_events")
}
