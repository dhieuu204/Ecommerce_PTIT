// Schema của user-service [U]. Chỉ service này được đọc/ghi database user_db.
// P1 đã chi tiết đủ cột (ACC-01..05, ADM-02). Khung các phase sau: docs/erd/README.md.

generator client {
  provider = "prisma-client-js"
  // Mỗi service sinh client riêng, không dùng chung node_modules/@prisma/client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Permission {
  MODERATION
  SUPPORT
  FINANCE
  SYSTEM
}

enum AuthProvider {
  GOOGLE
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AddressLabel {
  HOME
  OFFICE
}

/// Tài khoản. Một tài khoản vừa mua vừa bán được; admin là tài khoản có bộ quyền.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  /// Luôn lưu chữ thường
  email            String     @unique @db.VarChar(254)
  /// bcrypt; null nếu chỉ đăng nhập bằng Google
  passwordHash     String?    @map("password_hash") @db.VarChar(100)
  fullName         String     @map("full_name") @db.VarChar(100)
  phone            String?    @db.VarChar(10)
  dateOfBirth      DateTime?  @map("date_of_birth") @db.Date
  gender           Gender?
  status           UserStatus @default(UNVERIFIED)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Số lần đăng nhập sai liên tiếp; đủ 5 thì đặt loginLockedUntil = +15 phút
  failedLoginCount Int        @default(0) @map("failed_login_count")
  loginLockedUntil DateTime?  @map("login_locked_until") @db.Timestamptz(3)
  /// Lý do admin khóa (status = LOCKED)
  lockedReason     String?    @map("locked_reason") @db.VarChar(500)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities    UserIdentity[]
  codes         VerificationCode[]
  refreshTokens RefreshToken[]
  addresses     Address[]
  permissions   UserPermission[]

  @@index([status])
  @@map("users")
}

/// Liên kết đăng nhập ngoài (Google). Email Google trùng tài khoản có sẵn thì gắn vào tài khoản đó.
model UserIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  /// "sub" của Google
  providerSubject String       @map("provider_subject") @db.VarChar(255)
  email           String       @db.VarChar(254)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("user_identities")
}

/// Mã 6 số gửi qua email: xác minh tài khoản hoặc đặt lại mật khẩu. Hạn 10 phút, sai tối đa 5 lần, dùng một lần.
model VerificationCode {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  purpose   CodePurpose
  /// Không lưu mã gốc, chỉ lưu bản băm
  codeHash  String      @map("code_hash") @db.VarChar(100)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  attempts  Int         @default(0)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("verification_codes")
}

/// Refresh token (7 ngày). Mỗi lần refresh tạo token mới cùng familyId và thu hồi token cũ.
/// Token đã thu hồi bị dùng lại → thu hồi cả family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 của token; không lưu token gốc
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Sổ địa chỉ (ACC-04), tối đa 10 địa chỉ mỗi người. Mã theo GHN; tên lưu kèm để hiển thị.
/// Mỗi người đúng một địa chỉ mặc định: chỉ mục riêng phần trong migration.
model Address {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  recipientName String        @map("recipient_name") @db.VarChar(100)
  phone         String        @db.VarChar(10)
  provinceId    Int           @map("province_id")
  districtId    Int           @map("district_id")
  wardCode      String        @map("ward_code") @db.VarChar(20)
  provinceName  String        @map("province_name") @db.VarChar(100)
  districtName  String        @map("district_name") @db.VarChar(100)
  wardName      String        @map("ward_name") @db.VarChar(100)
  /// Số nhà, tên đường
  street        String        @db.VarChar(200)
  label         AddressLabel?
  isDefault     Boolean       @default(false) @map("is_default")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Bộ quyền admin của từng tài khoản (ACC-05). Mỗi lần cấp/thu hồi ghi audit_logs.
model UserPermission {
  userId     String     @map("user_id") @db.Uuid
  permission Permission
  grantedBy  String?    @map("granted_by") @db.Uuid
  grantedAt  DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

// ===== Bảng nền tảng: giống nhau ở cả 4 service =====

/// Nhật ký thao tác admin (ADM-02). Chỉ thêm, không sửa, không xóa.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  actorName     String   @map("actor_name") @db.VarChar(100)
  /// Ví dụ USER_PERMISSIONS_SET, SHOP_REVIEW_DECIDED
  action        String   @db.VarChar(64)
  /// Ví dụ USER, SHOP, SHOP_REVIEW
  targetType    String   @map("target_type") @db.VarChar(32)
  targetId      String   @map("target_id") @db.VarChar(64)
  reason        String?  @db.VarChar(500)
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Sự kiện chờ gửi lên RabbitMQ (outbox). Ghi trong cùng giao dịch với dữ liệu nghiệp vụ.
model OutboxEvent {
  /// = eventId trong vỏ sự kiện
  id          String    @id @db.Uuid
  type        String    @db.VarChar(100)
  /// Toàn bộ vỏ sự kiện (EventEnvelope trong packages/shared)
  envelope    Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Sự kiện đã xử lý (inbox), để bỏ qua bản RabbitMQ giao trùng.
model InboxEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("inbox_events")
}
