PORT=3001
DATABASE_URL=postgresql://user_svc:user_svc@localhost:5432/user_db?schema=public
RABBITMQ_URL=amqp://san:san@localhost:5672
# Khóa riêng ký access token (PEM). Để trống: dùng khóa tạm khi dev. Tạo khóa cố định: node scripts/gen-jwt-key.mjs
JWT_PRIVATE_KEY=

# Địa chỉ web (chuyển về sau khi đăng nhập Google) và API marketplace (kiểm tỉnh/huyện/xã)
WEB_URL=http://localhost:5173
MARKETPLACE_API_URL=http://localhost:3002/api/market/v1

# Gửi mail. Dev: Mailpit, hộp thư giả xem ở http://localhost:8025 (không gửi thật).
# Demo bằng Gmail: smtps://<gmail>:<mat-khau-ung-dung>@smtp.gmail.com:465 (chỉ ghi trong .env, không commit)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Sàn TMĐT <no-reply@san.local>"

# Đăng nhập Google (ứng dụng OAuth trên Google Cloud). Để trống: nút Google báo chưa cấu hình.
# Redirect URL khai trên Google phải trùng GOOGLE_REDIRECT_URL (đi qua web để cookie cùng tên miền).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/api/user/v1/auth/google/callback

# Con số cấu hình P1 (bỏ trống = giá trị mặc định đã chốt, xem src/config.ts)
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_ADDRESSES=10
