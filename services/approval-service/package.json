{
  "name": "@san/approval-service",
  "version": "0.1.0",
  "private": true,
  "description": "Hồ sơ duyệt shop/vi phạm, kiểm tra đơn theo luật, quyết định tranh chấp, duyệt rút tiền. Chỉ LƯU quyết định; M và P áp dụng",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:demo": "nest build && node dist/scripts/seed-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "~6.19.0",
    "@san/nest-common": "workspace:*",
    "@san/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "~6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
