// Schema của approval-service [A]. Chỉ service này được đọc/ghi database approval_db.
// A chỉ lưu hồ sơ và quyết định; marketplace và payment tự áp dụng quyết định.
// P1: duyệt shop. P2: đình chỉ shop. P3: kiểm tra đơn. P5: tranh chấp, điều chỉnh, duyệt rút tiền.
// Khung các phase sau: docs/erd/README.md.

generator client {
  provider = "prisma-client-js"
  // Mỗi service sinh client riêng, không dùng chung node_modules/@prisma/client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationType {
  REGISTER
  CHANGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Shop nộp bản mới trước khi admin xét bản này
  REPLACED
}

/// Hồ sơ shop chờ admin duyệt. Tạo khi nhận sự kiện shop_application.submitted.
model ShopApproval {
  id            String          @id @default(uuid()) @db.Uuid
  shopId        String          @map("shop_id") @db.Uuid
  version       Int
  type          ApplicationType
  status        ApprovalStatus  @default(PENDING)
  /// Chủ shop: admin trùng người này thì không được duyệt
  ownerId       String          @map("owner_id") @db.Uuid
  ownerName     String          @map("owner_name") @db.VarChar(100)
  ownerEmail    String          @map("owner_email") @db.VarChar(254)
  /// Toàn bộ hồ sơ nhận trong sự kiện
  data          Json
  /// Chỉ với CHANGE: các mục muốn đổi và giá trị cũ ({ fields, old })
  change        Json?
  submittedAt   DateTime        @map("submitted_at") @db.Timestamptz(3)
  /// Lý do (bắt buộc khi từ chối)
  reason        String?         @db.VarChar(500)
  decidedBy     String?         @map("decided_by") @db.Uuid
  decidedByName String?         @map("decided_by_name") @db.VarChar(100)
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(3)

  @@unique([shopId, version])
  @@index([status, submittedAt])
  @@map("shop_approvals")
}

enum ViolationTarget {
  SHOP
}

enum ViolationAction {
  SUSPEND
  RESTORE
}

/// Quyết định xử lý vi phạm (SHP-04): đình chỉ hoặc khôi phục shop.
/// P2 chỉ có admin tự đình chỉ/khôi phục shop; P6 (MOD-01) thêm báo cáo của buyer, bằng chứng, sản phẩm.
model Violation {
  id            String          @id @default(uuid()) @db.Uuid
  targetType    ViolationTarget @default(SHOP) @map("target_type")
  /// Mã shop bên marketplace
  targetId      String          @map("target_id") @db.Uuid
  /// Tên shop lúc quyết định (để xem lại lịch sử)
  targetName    String          @map("target_name") @db.VarChar(100)
  /// Chủ shop: admin trùng người này thì không được xử lý
  ownerId       String          @map("owner_id") @db.Uuid
  action        ViolationAction
  reason        String          @db.VarChar(500)
  decidedBy     String          @map("decided_by") @db.Uuid
  decidedByName String          @map("decided_by_name") @db.VarChar(100)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetId, createdAt])
  @@map("violations")
}

// ===== Kiểm tra đơn (P3) =====

enum OrderCheckStatus {
  /// Chạm luật, chờ admin tài chính duyệt
  PENDING
  /// Qua (không chạm luật thì qua ngay, hoặc admin duyệt)
  PASSED
  REJECTED
  /// Quá hạn chưa duyệt: không bao giờ tự duyệt, đơn bị hủy
  TIMEOUT
  /// Đơn bị hủy trong lúc chờ duyệt, admin không phải duyệt nữa
  CANCELLED
}

/// Kiểm tra đơn theo luật (RSK-01). Mọi đơn có một dòng; đơn lớn chờ admin FINANCE duyệt
model OrderCheck {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @unique @map("order_id") @db.Uuid
  orderCode     String           @map("order_code") @db.VarChar(20)
  buyerId       String           @map("buyer_id") @db.Uuid
  buyerName     String           @map("buyer_name") @db.VarChar(100)
  buyerEmail    String           @map("buyer_email") @db.VarChar(255)
  /// Chủ các shop trong đơn: không được tự duyệt
  ownerIds      String[]         @map("owner_ids") @db.Uuid
  amount        Int
  paymentMethod String           @map("payment_method") @db.VarChar(10)
  /// Đơn nhận qua sự kiện order.placed (shop, dòng hàng, tỉnh nhận)
  data          Json
  /// Luật đã chạm kèm ngưỡng lúc đó, ví dụ [{ "rule": "TOTAL", "threshold": 10000000 }]
  rulesHit      Json             @map("rules_hit")
  status        OrderCheckStatus
  /// Hạn duyệt (chỉ với PENDING)
  deadline      DateTime?        @db.Timestamptz(3)
  reason        String?          @db.VarChar(500)
  /// Admin quyết định (userId); trống khi tự động
  decidedBy     String?          @map("decided_by") @db.Uuid
  decidedByName String?          @map("decided_by_name") @db.VarChar(100)
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, deadline])
  @@index([buyerId])
  @@map("order_checks")
}

// ===== Tranh chấp, điều chỉnh, rút tiền (P5) =====

enum DisputeType {
  /// Tranh chấp trả hàng: admin hỗ trợ phân xử (DIS-01)
  RETURN
  /// Điều chỉnh tiền sau giải ngân: admin tài chính lập, admin tài chính khác duyệt (DIS-02)
  ADJUSTMENT
}

enum DisputeStage {
  /// Shop từ chối yêu cầu trả hàng, người mua khiếu nại
  REQUEST_REJECTED
  /// Shop báo hàng trả về không đúng
  GOODS_PROBLEM
}

enum DisputeStatus {
  /// Chờ admin quyết (RETURN) / chờ admin thứ hai duyệt (ADJUSTMENT)
  PENDING
  /// RETURN: đã phân xử
  RESOLVED
  /// ADJUSTMENT: đã duyệt, chờ payment-service thực thi
  APPROVED
  /// ADJUSTMENT: không duyệt
  REJECTED
  /// ADJUSTMENT: payment-service đã thực thi
  EXECUTED
  /// ADJUSTMENT: payment-service không thực thi được (ví dụ không đủ số dư)
  FAILED
}

enum DisputeDecision {
  /// RETURN giai đoạn 1: người mua gửi hàng về, shop kiểm như thường
  ACCEPT_RETURN
  /// RETURN: hoàn refund_amount (toàn bộ hoặc một phần)
  REFUND
  /// RETURN: không hoàn; ADJUSTMENT: không duyệt
  REJECT
  /// ADJUSTMENT: duyệt
  APPROVE
}

/// Hồ sơ cần admin quyết: tranh chấp trả hàng (DIS-01) và đề nghị điều chỉnh tiền sau giải ngân (DIS-02),
/// gộp một bảng theo vòng ERD (lời hai bên và điều chỉnh tiền là cột của tranh chấp)
model Dispute {
  id              String           @id @default(uuid()) @db.Uuid
  type            DisputeType
  /// RETURN: yêu cầu trả hàng bên marketplace
  returnId        String?          @map("return_id") @db.Uuid
  returnCode      String?          @map("return_code") @db.VarChar(28)
  stage           DisputeStage?
  orderId         String           @map("order_id") @db.Uuid
  orderCode       String           @map("order_code") @db.VarChar(20)
  shopOrderId     String           @map("shop_order_id") @db.Uuid
  shopOrderCode   String           @map("shop_order_code") @db.VarChar(24)
  shopId          String           @map("shop_id") @db.Uuid
  shopName        String           @map("shop_name") @db.VarChar(100)
  /// Chủ shop: admin trùng người này không được quyết
  ownerId         String           @map("owner_id") @db.Uuid
  /// Người mua: admin trùng người này không được quyết
  buyerId         String           @map("buyer_id") @db.Uuid
  buyerName       String           @map("buyer_name") @db.VarChar(100)
  /// RETURN: hồ sơ trả hàng nhận qua sự kiện (lý do, mô tả, ảnh, món, phương thức thanh toán)
  data            Json?
  buyerStatement  String?          @map("buyer_statement") @db.VarChar(1000)
  buyerImages     String[]         @map("buyer_images")
  sellerStatement String?          @map("seller_statement") @db.VarChar(1000)
  sellerImages    String[]         @map("seller_images")
  /// RETURN: số hoàn tối đa
  maxRefund       Int?             @map("max_refund")
  status          DisputeStatus    @default(PENDING)
  decision        DisputeDecision?
  /// RETURN: số hoàn đã quyết; ADJUSTMENT: hoàn thêm cho người mua
  refundAmount    Int?             @map("refund_amount")
  /// ADJUSTMENT: cộng (dương) hoặc trừ (âm) ngăn khả dụng của shop
  sellerChange    Int?             @map("seller_change")
  /// ADJUSTMENT: tài khoản nhận tiền hoàn của người mua { bankName, accountNumber, accountName }
  bankAccount     Json?            @map("bank_account")
  /// ADJUSTMENT: lý do đề nghị
  reason          String?          @db.VarChar(500)
  /// ADJUSTMENT: admin lập đề nghị (không được tự duyệt)
  createdBy       String?          @map("created_by") @db.Uuid
  createdByName   String?          @map("created_by_name") @db.VarChar(100)
  /// ADJUSTMENT: Idempotency-Key lúc lập
  requestKey      String?          @unique @map("request_key") @db.VarChar(64)
  /// RETURN: hạn phân xử (chỉ để nhắc, không tự quyết)
  deadline        DateTime?        @db.Timestamptz(3)
  decisionNote    String?          @map("decision_note") @db.VarChar(500)
  decidedBy       String?          @map("decided_by") @db.Uuid
  decidedByName   String?          @map("decided_by_name") @db.VarChar(100)
  decidedAt       DateTime?        @map("decided_at") @db.Timestamptz(3)
  /// ADJUSTMENT: kết quả payment-service thực thi (lý do khi không thực thi được)
  executionNote   String?          @map("execution_note") @db.VarChar(500)
  executedAt      DateTime?        @map("executed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([returnId, stage])
  @@index([type, status, createdAt])
  @@map("disputes")
}

enum WithdrawalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Seller hủy trước khi duyệt
  CANCELLED
}

/// Hồ sơ duyệt rút tiền (FIN-05). Tạo khi nhận withdrawal.requested; mọi yêu cầu rút đều phải duyệt
model WithdrawalApproval {
  id            String                   @id @default(uuid()) @db.Uuid
  /// Yêu cầu rút bên payment-service
  withdrawalId  String                   @unique @map("withdrawal_id") @db.Uuid
  shopId        String                   @map("shop_id") @db.Uuid
  shopName      String                   @map("shop_name") @db.VarChar(100)
  /// Chủ shop: admin trùng người này không được tự duyệt
  ownerId       String                   @map("owner_id") @db.Uuid
  ownerName     String                   @map("owner_name") @db.VarChar(100)
  amount        Int
  /// Tài khoản nhận (chỉ 4 số cuối) { bankName, accountNumberMasked, accountName }
  bankAccount   Json                     @map("bank_account")
  /// Số dư ví lúc yêu cầu (sau khi khóa) { pending, available, locked }
  wallet        Json
  status        WithdrawalApprovalStatus @default(PENDING)
  reason        String?                  @db.VarChar(500)
  decidedBy     String?                  @map("decided_by") @db.Uuid
  decidedByName String?                  @map("decided_by_name") @db.VarChar(100)
  decidedAt     DateTime?                @map("decided_at") @db.Timestamptz(3)
  requestedAt   DateTime                 @map("requested_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, requestedAt])
  @@map("withdrawal_approvals")
}

/// Cấu hình có phiên bản (ADM-01): ngưỡng duyệt, hạn duyệt. Phiên bản lớn nhất đang dùng
model Setting {
  key           String   @db.VarChar(64)
  version       Int
  value         Int
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  /// Admin sửa (userId)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(100)
  reason        String?  @db.VarChar(500)

  @@id([key, version])
  @@map("settings")
}

// ===== Bảng kỹ thuật: giống nhau ở cả 4 service =====

/// Nhật ký thao tác admin (ADM-02). Chỉ thêm, không sửa, không xóa.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(100)
  /// Ví dụ SET_PERMISSIONS, APPROVE_SHOP
  action     String   @db.VarChar(64)
  /// Ví dụ USER, SHOP
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(64)
  reason     String?  @db.VarChar(500)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Sự kiện chờ gửi lên RabbitMQ. Ghi cùng lúc (cùng giao dịch) với dữ liệu nghiệp vụ, tiến trình riêng gửi đi.
model OutboxEvent {
  /// = eventId của sự kiện
  id        String    @id @db.Uuid
  type      String    @db.VarChar(100)
  /// Toàn bộ sự kiện (EventEnvelope trong packages/shared)
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// null = chưa gửi được
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([sentAt])
  @@map("outbox_events")
}

/// Sự kiện đã nhận và xử lý xong. Gặp lại cùng id thì bỏ qua (RabbitMQ có thể giao 2 lần).
model InboxEvent {
  /// = eventId của sự kiện
  id          String   @id @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("inbox_events")
}
