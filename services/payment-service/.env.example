PORT=3003
DATABASE_URL=postgresql://payment_svc:payment_svc@localhost:5432/payment_db?schema=public
RABBITMQ_URL=amqp://san:san@localhost:5672
# Nơi lấy khóa công khai để kiểm access token (user-service)
JWKS_URL=http://localhost:3001/api/user/v1/.well-known/jwks.json

# VNPay sandbox. Để trống cả hai: dùng cổng MÔ PHỎNG (không có tiền thật, giao diện ghi "MÔ PHỎNG").
# Lấy ở email đăng ký sandbox của VNPay. Bí mật: chỉ ghi trong .env, không commit, không gửi qua chat.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Web của sàn: VNPay đưa buyer về ${WEB_URL}/thanh-toan/ket-qua
WEB_URL=http://localhost:5173
# Cổng mô phỏng: kết quả lệnh hoàn (SUCCEEDED, FAILED, UNKNOWN) để thử luồng hoàn tay
MOCK_REFUND_RESULT=SUCCEEDED

# MinIO: ảnh biên lai hoàn tay, bucket riêng tư. Khớp infra/docker-compose.yml
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_PRIVATE_BUCKET=san-private
RECEIPT_MAX_MB=5

# ----- P5: rút tiền -----
# Lấy tài khoản ngân hàng của shop (bằng vé đăng nhập của seller) khi seller gửi yêu cầu rút.
# Số rút tối thiểu nằm trong bảng settings (trang "Cấu hình chính sách").
MARKETPLACE_API_URL=http://localhost:3002/api/market/v1
