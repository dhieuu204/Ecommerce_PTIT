// Schema của payment-service [P]. Chỉ service này được đọc/ghi database payment_db.
// P3: thu tiền VNPay, hoàn tiền, tiền seller của mỗi đơn con. P4: ví seller, đối soát COD và VNPay.

generator client {
  provider = "prisma-client-js"
  // Mỗi service sinh client riêng, không dùng chung node_modules/@prisma/client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Thu tiền, hoàn tiền (P3) =====

enum PaymentMethod {
  VNPAY
  /// Thanh toán khi nhận hàng (P4)
  COD
}

enum EarningStatus {
  /// Chưa có tiền: đơn trả trước chưa trả, hoặc đơn COD chưa giao
  UNPAID
  /// Tiền seller nằm ở ngăn đang giữ (trả trước: đã thu; COD: đã giao)
  HELD
  /// Đã chuyển sang ngăn khả dụng (đơn hoàn tất và tiền đã về sàn)
  AVAILABLE
  /// Hết hạn thanh toán, không có tiền
  EXPIRED
  /// Đơn con bị hủy (nếu đã thu thì có khoản hoàn)
  CANCELLED
  /// Giao thất bại, hàng hoàn về shop
  FAILED
  /// Sự cố GHN đã xác nhận, seller được đền vào ngăn khả dụng
  COMPENSATED
}

/// Tiền của mỗi đơn con (PAY-04, FIN-03): buyer trả bao nhiêu, phí sàn, seller nhận bao nhiêu.
/// Cũng là bản chép đơn nhận qua sự kiện order.placed để biết số tiền cần thu
model SellerEarning {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  orderCode        String        @map("order_code") @db.VarChar(20)
  shopOrderId      String        @unique @map("shop_order_id") @db.Uuid
  shopOrderCode    String        @map("shop_order_code") @db.VarChar(24)
  shopId           String        @map("shop_id") @db.Uuid
  /// Người mua (userId)
  buyerId          String        @map("buyer_id") @db.Uuid
  subtotal         Int
  shopDiscount     Int           @map("shop_discount")
  /// Phần voucher sàn (sàn chịu, không trừ vào tiền seller)
  platformDiscount Int           @map("platform_discount")
  shippingFee      Int           @map("shipping_fee")
  /// Buyer trả cho đơn con = subtotal - shopDiscount - platformDiscount + shippingFee
  buyerPaid        Int           @map("buyer_paid")
  /// Phí sàn theo phần vạn (500 = 5%), chụp lúc nhận đơn
  platformFeeRate  Int           @map("platform_fee_rate")
  platformFee      Int           @map("platform_fee")
  /// Seller nhận = subtotal - shopDiscount - platformFee
  sellerAmount     Int           @map("seller_amount")
  status           EarningStatus @default(UNPAID)
  /// Trống với đơn COD (không có hạn thanh toán)
  payBefore        DateTime?     @map("pay_before") @db.Timestamptz(3)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  // ----- P4 -----
  paymentMethod    PaymentMethod @default(VNPAY) @map("payment_method")
  /// Số GHN thu hộ (= buyerPaid với COD, 0 với trả trước)
  codAmount        Int           @default(0) @map("cod_amount")
  /// Mã vận đơn GHN (nhận khi đã giao), dùng khớp file đối soát
  ghnCode          String?       @map("ghn_code") @db.VarChar(40)
  /// Phí GHN tính cho vận đơn
  carrierFee       Int?          @map("carrier_fee")
  deliveredAt      DateTime?     @map("delivered_at") @db.Timestamptz(3)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)
  /// Tiền đã về sàn: trả trước lúc thu, COD lúc đối soát khớp
  moneyReceivedAt  DateTime?     @map("money_received_at") @db.Timestamptz(3)
  /// Lúc chuyển sang ngăn khả dụng
  releasedAt       DateTime?     @map("released_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId])
  @@index([status, payBefore])
  @@index([shopId, createdAt])
  @@index([ghnCode])
  @@map("seller_earnings")
}

// ===== Ví seller (P4: FIN-01, FIN-02) =====

/// Ví của mỗi shop: 3 ngăn tiền, không ngăn nào được âm (ràng buộc CHECK trong database)
model SellerWallet {
  shopId    String   @id @map("shop_id") @db.Uuid
  /// Chủ shop (userId), nhận qua order.placed: seller xem ví bằng vé đăng nhập của mình
  ownerId   String   @unique @map("owner_id") @db.Uuid
  /// Đang giữ: đã có tiền nhưng đơn chưa hoàn tất hoặc tiền COD chưa đối soát
  pending   Int      @default(0)
  /// Khả dụng: rút được (P5)
  available Int      @default(0)
  /// Đang khóa cho yêu cầu rút tiền (P5)
  locked    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions WalletTransaction[]

  @@map("seller_wallets")
}

enum WalletTxType {
  /// Tiền đơn con vào ngăn đang giữ
  HELD
  /// Đang giữ → khả dụng
  RELEASED
  /// Trừ lại khỏi ngăn đang giữ (đơn hủy, giao thất bại, sự cố)
  REVERSED
  /// Đền cho seller khi GHN làm mất/hỏng hàng, vào thẳng ngăn khả dụng
  COMPENSATION
}

enum WalletBucket {
  PENDING
  AVAILABLE
  LOCKED
}

/// Lịch sử ví: mỗi biến động một dòng, không sửa không xóa. Mỗi đơn con mỗi loại tối đa một dòng
model WalletTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  type        WalletTxType
  /// Luôn dương
  amount      Int
  /// Trống = tiền vào ví từ ngoài
  fromBucket  WalletBucket? @map("from_bucket")
  /// Trống = tiền ra khỏi ví
  toBucket    WalletBucket? @map("to_bucket")
  shopOrderId String?       @map("shop_order_id") @db.Uuid
  note        String?       @db.VarChar(300)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet SellerWallet @relation(fields: [shopId], references: [shopId])

  @@unique([shopOrderId, type])
  @@index([shopId, createdAt])
  @@map("wallet_transactions")
}

// ===== Đối soát COD (P4: COD-02, SHIP-05) =====

/// Mỗi lần admin tài chính nhập file đối soát COD của GHN
model CodReconciliation {
  id             String   @id @default(uuid()) @db.Uuid
  fileName       String   @map("file_name") @db.VarChar(200)
  /// File gốc trong MinIO (bucket riêng tư)
  fileKey        String   @map("file_key") @db.VarChar(200)
  /// Mã băm nội dung: mỗi file chỉ nhập một lần
  fileHash       String   @unique @map("file_hash") @db.VarChar(64)
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  uploadedByName String   @map("uploaded_by_name") @db.VarChar(100)
  totalRows      Int      @map("total_rows")
  matched        Int
  mismatched     Int
  duplicated     Int
  notFound       Int      @map("not_found")
  notDelivered   Int      @map("not_delivered")
  /// Tổng tiền COD theo file
  totalCod       Int      @map("total_cod")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items CodReconciliationItem[]

  @@index([createdAt])
  @@map("cod_reconciliations")
}

enum ReconcileResult {
  /// Khớp mã vận đơn và số tiền: tiền COD coi là đã về sàn
  MATCHED
  /// Lệch số tiền: chờ admin xử lý
  MISMATCHED
  /// Vận đơn đã đối soát trước đó: không cộng lần nữa
  DUPLICATE
  NOT_FOUND
  /// Vận đơn chưa giao xong
  NOT_DELIVERED
}

enum ReconcileResolution {
  /// Chấp nhận số GHN, coi tiền đã về
  ACCEPTED
  /// Chỉ ghi chú, để lại
  NOTED
}

/// Từng dòng trong file đối soát COD
model CodReconciliationItem {
  id               String               @id @default(uuid()) @db.Uuid
  reconciliationId String               @map("reconciliation_id") @db.Uuid
  rowNumber        Int                  @map("row_number")
  // Theo file GHN
  ghnCode          String               @map("ghn_code") @db.VarChar(40)
  codAmount        Int                  @map("cod_amount")
  shipFee          Int                  @map("ship_fee")
  returnFee        Int                  @map("return_fee")
  // Theo sàn
  shopOrderId      String?              @map("shop_order_id") @db.Uuid
  expectedCod      Int?                 @map("expected_cod")
  /// Phí ship sàn đã thu của người mua
  buyerShippingFee Int?                 @map("buyer_shipping_fee")
  result           ReconcileResult
  resolution       ReconcileResolution?
  note             String?              @db.VarChar(500)
  resolvedBy       String?              @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)

  reconciliation CodReconciliation @relation(fields: [reconciliationId], references: [id])

  @@index([reconciliationId, rowNumber])
  @@index([ghnCode])
  @@map("cod_reconciliation_items")
}

enum Gateway {
  VNPAY
  /// Cổng mô phỏng khi chưa có khóa VNPay
  MOCK
}

enum PaymentStatus {
  /// Đã tạo link, chờ kết quả
  PENDING
  SUCCEEDED
  FAILED
  /// Chưa rõ kết quả: không tạo lần mới, job tra cứu
  UNKNOWN
}

/// Mỗi lần thanh toán VNPay của một đơn tổng (PAY-01..03), tối đa 3 lần
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  attempt         Int
  /// = vnp_TxnRef, mã giao dịch riêng của mỗi lần
  ref             String        @unique @db.VarChar(40)
  /// Idempotency-Key của lần bấm "Thanh toán"
  requestKey      String        @unique @map("request_key") @db.VarChar(64)
  gateway         Gateway
  amount          Int
  payUrl          String        @map("pay_url") @db.VarChar(2000)
  status          PaymentStatus @default(PENDING)
  /// Tiền được áp vào đơn; false + SUCCEEDED = trả muộn/trả trùng, đã tạo khoản hoàn
  applied         Boolean       @default(false)
  transactionNo   String?       @map("transaction_no") @db.VarChar(40)
  bankCode        String?       @map("bank_code") @db.VarChar(20)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// IP người mua (VNPay yêu cầu vnp_IpAddr)
  clientIp        String        @map("client_ip") @db.VarChar(45)
  /// Dữ liệu VNPay gửi/trả gần nhất (không chứa khóa bí mật)
  gatewayResponse Json?         @map("gateway_response")
  /// Lần tra cứu gần nhất
  checkedAt       DateTime?     @map("checked_at") @db.Timestamptz(3)
  // ----- Đối soát VNPay (P4: PAY-05) -----
  reconcileStatus ReconcileStatus? @map("reconcile_status")
  reconcileNote   String?          @map("reconcile_note") @db.VarChar(500)
  reconciledAt    DateTime?        @map("reconciled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  refunds Refund[]

  @@unique([orderId, attempt])
  @@index([reconcileStatus])
  @@map("payments")
}

enum ReconcileStatus {
  /// Tra cứu lại VNPay khớp
  MATCHED
  /// Lệch (số tiền/trạng thái), chờ admin tài chính xem
  MISMATCH
  /// Admin đã xử lý, có ghi chú
  RESOLVED
}

enum RefundReason {
  /// Đơn con bị hủy sau khi đã trả
  CANCELLED
  /// Tiền về sau khi đơn đã hết hạn/hủy
  LATE_PAYMENT
  /// Đơn đã được trả bằng lần khác
  DUPLICATE_PAYMENT
  /// Giao thất bại lần cuối: hoàn tiền hàng sau voucher (P4)
  DELIVERY_FAILED
  /// GHN làm mất/hỏng hàng: hoàn đủ (P4)
  INCIDENT
}

enum RefundStatus {
  /// Chờ gửi lệnh
  PENDING
  /// Lỗi, chờ thử lại theo lịch
  FAILED
  /// Đã gửi lệnh nhưng chưa rõ kết quả: tra cứu, không gửi lại mù quáng
  UNKNOWN
  /// Thử đủ số lần vẫn lỗi: chờ admin tài chính hoàn tay
  NEEDS_MANUAL
  SUCCEEDED
  /// Admin đã chuyển khoản tay, có chứng từ
  MANUAL_DONE
}

/// Hoàn tiền cho buyer (REF-01). Mỗi đơn con tối đa một khoản hoàn ở P3
model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  /// Trống = hoàn cả khoản trả muộn/trả trùng
  shopOrderId     String?      @unique @map("shop_order_id") @db.Uuid
  amount          Int
  reason          RefundReason
  status          RefundStatus @default(PENDING)
  /// Số lần đã gửi lệnh hoàn qua cổng
  tries           Int          @default(0)
  nextTryAt       DateTime?    @map("next_try_at") @db.Timestamptz(3)
  /// Mã lệnh hoàn gần nhất (vnp_RequestId), mỗi lần gửi một mã
  requestId       String?      @map("request_id") @db.VarChar(40)
  lastError       String?      @map("last_error") @db.VarChar(500)
  gatewayResponse Json?        @map("gateway_response")
  // Hoàn tay
  transferCode    String?      @map("transfer_code") @db.VarChar(60)
  receiptKey      String?      @map("receipt_key") @db.VarChar(200)
  manualNote      String?      @map("manual_note") @db.VarChar(500)
  /// Admin tài chính hoàn tay (userId)
  manualBy        String?      @map("manual_by") @db.Uuid
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status, nextTryAt])
  @@index([orderId])
  @@map("refunds")
}

/// Cấu hình có phiên bản (ADM-01): phí sàn, số lần thanh toán, số lần thử hoàn. Phiên bản lớn nhất đang dùng
model Setting {
  key           String   @db.VarChar(64)
  version       Int
  value         Int
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  /// Admin sửa (userId)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(100)
  reason        String?  @db.VarChar(500)

  @@id([key, version])
  @@map("settings")
}

// ===== Bảng kỹ thuật: giống nhau ở cả 4 service =====

/// Nhật ký thao tác admin (ADM-02). Chỉ thêm, không sửa, không xóa.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(100)
  /// Ví dụ SET_PERMISSIONS, APPROVE_SHOP
  action     String   @db.VarChar(64)
  /// Ví dụ USER, SHOP
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(64)
  reason     String?  @db.VarChar(500)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Sự kiện chờ gửi lên RabbitMQ. Ghi cùng lúc (cùng giao dịch) với dữ liệu nghiệp vụ, tiến trình riêng gửi đi.
model OutboxEvent {
  /// = eventId của sự kiện
  id        String    @id @db.Uuid
  type      String    @db.VarChar(100)
  /// Toàn bộ sự kiện (EventEnvelope trong packages/shared)
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// null = chưa gửi được
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([sentAt])
  @@map("outbox_events")
}

/// Sự kiện đã nhận và xử lý xong. Gặp lại cùng id thì bỏ qua (RabbitMQ có thể giao 2 lần).
model InboxEvent {
  /// = eventId của sự kiện
  id          String   @id @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("inbox_events")
}
