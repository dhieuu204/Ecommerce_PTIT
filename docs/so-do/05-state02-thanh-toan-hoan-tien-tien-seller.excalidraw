  {
   "type": "text",
   "version": 1,
   "versionNonce": 1781644014,
   "isDeleted": false,
   "id": "e4a37fa2d",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
